{
  "name": "blind-date-club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node --env-file=.env.local scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "local:setup": "node scripts/local-start.mjs && node scripts/local-migrate.mjs",
    "local:start": "node scripts/local-start.mjs",
    "db:migrate": "node scripts/local-migrate.mjs",
    "demo:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "format": "prettier --write src tests scripts docs README.md *.ts *.mjs *.json",
    "format:check": "prettier --check src tests scripts docs README.md *.ts *.mjs *.json"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.10",
    "supabase": "2.101.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16 <25"
  }
}
