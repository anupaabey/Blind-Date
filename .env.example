# Public Supabase project settings; never put privileged keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, required only for verified payment callbacks and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:3000
# Optional. Payments remain disabled without a merchant configuration.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Optional Resend transport. Auth emails are sent by Supabase Auth.
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
